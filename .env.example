# Copy to .env.local for local dev, and set these in Vercel → Project → Settings → Environment Variables.
# Values below are placeholders — replace with the real IDs before launch.

# GA4 measurement ID (Admin → Data Streams → your web stream)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads conversion ID — one Google Ads account, shared across all campaigns
NEXT_PUBLIC_ADS_ID=AW-XXXXXXXXXX

# Conversion LABEL — one per campaign (each is its own conversion action in Google Ads).
# app/thanks/page.tsx picks the right one via ?campaign=<slug>. Add a new
# NEXT_PUBLIC_ADS_CONVERSION_LABEL_<SLUG> line (and a CAMPAIGNS entry in that file)
# for every new campaign page.
NEXT_PUBLIC_ADS_CONVERSION_LABEL_NABERS_RATING_TRACKING=abc123def456
NEXT_PUBLIC_ADS_CONVERSION_LABEL_SALESFORCE_ALTERNATIVE=abc123def456
# Fallback used only if a lead somehow reaches /thanks with no recognised ?campaign=
NEXT_PUBLIC_ADS_CONVERSION_LABEL=abc123def456

# Zoho CRM lead webhook — server-side only, no NEXT_PUBLIC_ prefix
ZOHO_WEBHOOK_URL=

# reCAPTCHA v3 — server-side secret + public site key
RECAPTCHA_SECRET=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
