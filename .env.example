# Copy to .env.local for local dev, and set these in Vercel → Project → Settings → Environment Variables.
# Every one of these is genuinely optional — the Studio runs, generates campaigns, and lets you preview
# landing pages with none of them set. They gate specific, clearly-flagged capabilities (see README.md).

# --- Site ---------------------------------------------------------------
# Public base URL used to build each campaign's public landing page URL.
NEXT_PUBLIC_SITE_URL=https://landing.ravenlabs.com

# --- Analytics / tracking (master spec §31) ------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# --- Legal / footer (required by Google Ads "Adequate Information" policy) --
NEXT_PUBLIC_BUSINESS_ABN=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=

# --- Lead delivery --------------------------------------------------------
# Zoho CRM lead webhook — server-side only, no NEXT_PUBLIC_ prefix.
ZOHO_WEBHOOK_URL=
# reCAPTCHA v3 — server-side secret + public site key.
RECAPTCHA_SECRET=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Vercel deployment (master spec §18/§19/§46) -------------------------
# Without these, Deployment tab publishes prepare the campaign and mark it
# PENDING_AUTHORIZATION rather than fabricating a live deployment.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
