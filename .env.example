# Copy to .env.local for local dev, and set these in Vercel → Project → Settings → Environment Variables.
# Values below are placeholders — replace with the real IDs before launch.

# GA4 measurement ID (Admin → Data Streams → your web stream)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads conversion ID + label (Tools & Settings → Conversions → your conversion action)
NEXT_PUBLIC_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_ADS_CONVERSION_LABEL=abc123def456

# Zoho CRM lead webhook — server-side only, no NEXT_PUBLIC_ prefix
ZOHO_WEBHOOK_URL=

# reCAPTCHA v3 — server-side secret + public site key
RECAPTCHA_SECRET=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
